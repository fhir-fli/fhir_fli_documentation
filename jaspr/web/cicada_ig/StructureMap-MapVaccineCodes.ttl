<http://fhirfli.dev/fhir/ig/cicada/StructureMap/MapVaccineCodes> a fhir:StructureMap ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "MapVaccineCodes"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: StructureMap MapVaccineCodes</b></p><a name=\"MapVaccineCodes\"> </a><a name=\"hcMapVaccineCodes\"> </a><pre class=\"fml\">#xD;\n<b>map</b><span style=\"color: navy\"> \"</span>http://fhirfli.dev/fhir/ig/cicada/StructureMap/MapVaccineCodes<span style=\"color: navy\">\" = \"</span>MapVaccineCodes<span style=\"color: navy\">\"#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">Define the usage of FHIR resource types with specific aliases</span>#xD;\n#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/observation.html\" title=\"Observation\">http://hl7.org/fhir/StructureDefinition/Observation</a><span style=\"color: navy\">\" </span><b>alias </b>sourceObservation <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/condition.html\" title=\"Condition\">http://hl7.org/fhir/StructureDefinition/Condition</a><span style=\"color: navy\">\" </span><b>alias </b>sourceCondition <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/procedure.html\" title=\"Procedure\">http://hl7.org/fhir/StructureDefinition/Procedure</a><span style=\"color: navy\">\" </span><b>alias </b>sourceProcedure <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/immunization.html\" title=\"Immunization\">http://hl7.org/fhir/StructureDefinition/Immunization</a><span style=\"color: navy\">\" </span><b>alias </b>sourceImmunization <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/medication.html\" title=\"Medication\">http://hl7.org/fhir/StructureDefinition/Medication</a><span style=\"color: navy\">\" </span><b>alias </b>sourceMedication <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/medicationstatement.html\" title=\"MedicationStatement\">http://hl7.org/fhir/StructureDefinition/MedicationStatement</a><span style=\"color: navy\">\" </span><b>alias </b>sourceMedicationStatement <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/medicationrequest.html\" title=\"MedicationRequest\">http://hl7.org/fhir/StructureDefinition/MedicationRequest</a><span style=\"color: navy\">\" </span><b>alias </b>sourceMedicationRequest <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/medicationadministration.html\" title=\"MedicationAdministration\">http://hl7.org/fhir/StructureDefinition/MedicationAdministration</a><span style=\"color: navy\">\" </span><b>alias </b>sourceMedicationAdministration <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/medicationdispense.html\" title=\"MedicationDispense\">http://hl7.org/fhir/StructureDefinition/MedicationDispense</a><span style=\"color: navy\">\" </span><b>alias </b>sourceMedicationDispense <b>as </b><b>source</b>#xD;\n<b>uses</b><span style=\"color: navy\"> \"</span><a href=\"http://hl7.org/fhir/R4/condition.html\" title=\"Condition\">http://hl7.org/fhir/StructureDefinition/Condition</a><span style=\"color: navy\">\" </span><b>alias </b>targetCondition <b>as </b><b>target</b>#xD;\n#xD;\n<b>group </b>MapToVaccineConditionObservation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span>, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>targetCondition<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<b> as </b><span style=\"color: maroon\">sourceObservation</span><b> where </b><span style=\"color: navy\">(</span>src is Observation<span style=\"color: navy\">)</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>MapFromObservation<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"SourceObservationToTarget\"</i><span style=\"color: navy\">;</span>#xD;\n  src<b> as </b><span style=\"color: maroon\">sourceCondition</span><b> where </b><span style=\"color: navy\">(</span>src is Condition<span style=\"color: navy\">)</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>MapFromCondition<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"SourceConditionToTarget\"</i><span style=\"color: navy\">;</span>#xD;\n  src<b> as </b><span style=\"color: maroon\">sourceProcedure</span><b> where </b><span style=\"color: navy\">(</span>src is Procedure<span style=\"color: navy\">)</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>MapFromProcedure<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"SourceProcedureToTarget\"</i><span style=\"color: navy\">;</span>#xD;\n  src<b> as </b><span style=\"color: maroon\">sourceImmunization</span><b> where </b><span style=\"color: navy\">(</span>src is Immunization<span style=\"color: navy\">)</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>MapFromImmunization<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"SourceImmunizationToTarget\"</i><span style=\"color: navy\">;</span>#xD;\n  src<b> as </b><span style=\"color: maroon\">sourceMedication</span><b> where </b><span style=\"color: navy\">(</span>src is Medication<span style=\"color: navy\">)</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>MapFromMedication<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"SourceMedicationToTarget\"</i><span style=\"color: navy\">;</span>#xD;\n  src<b> as </b><span style=\"color: maroon\">sourceMedicationStatement</span><b> where </b><span style=\"color: navy\">(</span>src is MedicationStatement<span style=\"color: navy\">)</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>MapFromMedicationStatement<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"SourceMedStatementToTarget\"</i><span style=\"color: navy\">;</span>#xD;\n  src<b> as </b><span style=\"color: maroon\">sourceMedicationRequest</span><b> where </b><span style=\"color: navy\">(</span>src is MedicationRequest<span style=\"color: navy\">)</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>MapFromMedicationRequest<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"SourceMedRequestToTarget\"</i><span style=\"color: navy\">;</span>#xD;\n  src<b> as </b><span style=\"color: maroon\">sourceMedicationAdministration</span><b> where </b><span style=\"color: navy\">(</span>src is MedicationAdministration<span style=\"color: navy\">)</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>MapFromMedicationAdministration<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"SourceMedAdminToTarget\"</i><span style=\"color: navy\">;</span>#xD;\n  src<b> as </b><span style=\"color: maroon\">sourceMedicationDispense</span><b> where </b><span style=\"color: navy\">(</span>src is MedicationDispense<span style=\"color: navy\">)</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>MapFromMedicationDispense<span style=\"color: navy\">(</span><span style=\"color: maroon\">src</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"SourceMedDispenseToTarget\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>MapFromObservation<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>sourceObservation, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>targetCondition<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.clinicalStatus = <b>cc</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/condition-clinical'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'active'</span><span style=\"color: navy\">)</span> <i>\"SetObservationStatus\"</i><span style=\"color: navy\">;</span>#xD;\n  src.code<b> as </b><span style=\"color: maroon\">code</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    code.coding<b> as </b><span style=\"color: maroon\">coding</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>ApplyCommonMappings<span style=\"color: navy\">(</span><span style=\"color: maroon\">coding</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"ApplyObsMappingsCoding\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"ApplyObsMappings\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.effectiveDateTime</span> <i>\"SetObsOnsetDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.effectivePeriod</span> <i>\"SetObsOnsetPeriod\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.effectiveInstant</span> <i>\"SetObsOnsetInstant\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>MapFromCondition<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>sourceCondition, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>targetCondition<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.clinicalStatus = <b>cc</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/condition-clinical'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'active'</span><span style=\"color: navy\">)</span> <i>\"SetConditionStatus\"</i><span style=\"color: navy\">;</span>#xD;\n  src.code<b> as </b><span style=\"color: maroon\">code</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    code.coding<b> as </b><span style=\"color: maroon\">coding</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>ApplyCommonMappings<span style=\"color: navy\">(</span><span style=\"color: maroon\">coding</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"ApplyCondMappingsCoding\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"ApplyCondMappings\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.onsetDateTime</span> <i>\"SetCondOnsetDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.onsetAge</span> <i>\"SetCondOnsetAge\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.onsetPeriod</span> <i>\"SetCondOnsetPeriod\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.onsetRange</span> <i>\"SetCondOnsetRange\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.onsetString</span> <i>\"SetCondOnsetString\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.abatement = <span style=\"color: maroon\">src.abatementDateTime</span> <i>\"SetCondAbatementDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.abatement = <span style=\"color: maroon\">src.abatementAge</span> <i>\"SetCondAbatementAge\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.abatement = <span style=\"color: maroon\">src.abatementPeriod</span> <i>\"SetCondAbatementPeriod\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.abatement = <span style=\"color: maroon\">src.abatementRange</span> <i>\"SetCondAbatementRange\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.abatement = <span style=\"color: maroon\">src.abatementString</span> <i>\"SetCondAbatementString\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>MapFromProcedure<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>sourceProcedure, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>targetCondition<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.clinicalStatus = <b>cc</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/condition-clinical'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'active'</span><span style=\"color: navy\">)</span> <i>\"SetProcedureStatus\"</i><span style=\"color: navy\">;</span>#xD;\n  src.code<b> as </b><span style=\"color: maroon\">code</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    code.coding<b> as </b><span style=\"color: maroon\">coding</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>ApplyCommonMappings<span style=\"color: navy\">(</span><span style=\"color: maroon\">coding</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"ApplyProcedureMappingsCoding\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"ApplyProcedureMappings\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.performedDateTime</span> <i>\"SetProcedureOnsetDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.performedAge</span> <i>\"SetProcedureOnsetAge\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.performedPeriod</span> <i>\"SetProcedureOnsetPeriod\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.performedRange</span> <i>\"SetProcedureOnsetRange\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.performedString</span> <i>\"SetProcedureOnsetString\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>MapFromImmunization<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>sourceImmunization, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>targetCondition<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.clinicalStatus = <b>cc</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/condition-clinical'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'active'</span><span style=\"color: navy\">)</span> <i>\"SetImmunizationStatus\"</i><span style=\"color: navy\">;</span>#xD;\n  src.vaccineCode<b> as </b><span style=\"color: maroon\">code</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    code.coding<b> as </b><span style=\"color: maroon\">coding</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>ApplyCommonMappings<span style=\"color: navy\">(</span><span style=\"color: maroon\">coding</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"ApplyImmunizationMappingsCoding\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"ApplyImmunizationMappings\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.occurrenceDateTime</span> <i>\"SetImmunizationOnsetDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.onset = <span style=\"color: maroon\">src.occurrenceString</span> <i>\"SetImmunizationOnsetString\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><b>group </b>MapFromMedication<span style=\"color: navy\">(</span><b>source</b> <span style=\"color: maroon\">src</span><span style=\"color: navy\"> : </span>sourceMedication, <b>target</b> <span style=\"color: maroon\">tgt</span><span style=\"color: navy\"> : </span>targetCondition<span style=\"color: navy\">)</span><span style=\"color: navy\"> {#xD;\n</span>  src<span style=\"color: navy\"><b> -&gt; </b></span>tgt.clinicalStatus = <b>cc</b><span style=\"color: navy\">(</span><span style=\"color: blue\">'http://terminology.hl7.org/CodeSystem/condition-clinical'</span><span style=\"color: navy\">, </span><span style=\"color: blue\">'active'</span><span style=\"color: navy\">)</span> <i>\"SetMedicationStatus\"</i><span style=\"color: navy\">;</span>#xD;\n  src.code<b> as </b><span style=\"color: maroon\">code</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    code.coding<b> as </b><span style=\"color: maroon\">coding</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt<b> then </b>ApplyCommonMappings<span style=\"color: navy\">(</span><span style=\"color: maroon\">coding</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"ApplyMedicationMappingsCoding\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">}</span> <i>\"ApplyMedicationMappings\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span sty