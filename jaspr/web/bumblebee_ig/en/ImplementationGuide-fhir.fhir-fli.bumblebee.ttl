       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-allergy-asked> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-allergy-asked" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Whether we asked about allergies" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Records that the question was asked, and what came back — including 'nothing known' and 'could not ask'. Exists because an empty allergy list means either 'asked, nothing found' or 'nobody asked', and those are different facts. Conflating them is how a patient gets given something that hurts them." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ] ;
