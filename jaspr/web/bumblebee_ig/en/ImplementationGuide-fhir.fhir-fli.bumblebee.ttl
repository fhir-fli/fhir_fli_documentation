     fhir:ImplementationGuide.definition.resource [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-related-person> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-related-person" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Accompanying person" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A parent, guardian or caregiver with the patient. Required because a child must not be separated from their parent or agreed caretaker, and because an unaccompanied minor is then a query — a child with no accompanying person — rather than a flag somebody has to remember to set." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/admin-division> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/admin-division" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Administrative division" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "State, city and village. FHIR's Location has no element for an administrative hierarchy, and in a displacement setting the village is often the only part anyone can name." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-allergy> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-allergy" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Allergy" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Something that will hurt this patient if we give it to them. Checked before anything is given. Absence of a record is NOT a record of absence — nobody may read a missing entry as 'no known allergies', which is why asking is recorded separately from the answer." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/departure-date> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/departure-date" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Anticipated date of departure" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "When the team expects to leave. Checked during field visits, and the handover to local health authorities must be coordinated at least seven days before shutdown." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ValueSet" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/ValueSet/body-region-vs> ;
         fhir:Reference.reference [ fhir:value "ValueSet/body-region-vs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Body region" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Every code, at every level. A clinician picks the one they can be sure of." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CodeSystem" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/CodeSystem/body-region-cs> ;
         fhir:Reference.reference [ fhir:value "CodeSystem/body-region-cs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Body region (code system)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Where on the body something is. This exists so a clinician can TAP A DIAGRAM instead of typing - required for documenting unexplained injuries in children, and used the same way by the one field-hospital system with a published evaluation. Every code is somewhere a person can point at." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-tbsa> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-tbsa" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Burn surface area" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "What percentage of the body is burned. Decides where the patient is treated — above 5% a Type 1 fixed team refers onward, above 20% it needs a Type 3 — and drives fluid resuscitation from the time of arrival." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-follow-up> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-follow-up" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Come back — when, and for what" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A planned return to us: a date, and the reason to come on it. Separate from a referral because nothing is handed over — the patient stays ours and no handover has to be closed. Most patients leave with nothing arranged at all, so a follow-up that was arranged is a fact worth being able to find, and it is the thing a return visit is matched against." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-complication> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-complication" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Complication" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Something that went wrong. The standards name possible complications in the one sentence that defines what a record must contain, and require a register of perioperative complications specifically. The clinical problem itself is recorded as a diagnosis; this points at it and marks it as an adverse event." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/deployment-tag> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/deployment-tag" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Deployment" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Which deployment produced this record. Makes purging one deployment a single verifiable operation." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-diagnosis> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-diagnosis" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Diagnosis made at this visit" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "What was wrong with the patient today. Kept apart from a problem they already had, because they are different clinical facts: the standing list is what this person lives with, today's diagnosis is what we are treating. Merge them and you lose the history a returning patient depends on." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/estimated-age> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/estimated-age" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Estimated age" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Age when date of birth is unknown, which in a disaster is common. FHIR has birthDate and nothing else, but age is what decides the dose, whether a child is screened for malnutrition, and how a presentation is read — and an estimate is often all anyone has." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/exposure-history> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/exposure-history" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Exposure history" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Where the person is thought to have been exposed. Asked for by the surveillance standards for notifiable conditions, and by nothing else." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-body-site-finding> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-body-site-finding" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Finding, marked on a body diagram" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Something seen or felt, attached to a place on the body. The clinician taps where rather than describing where. Required by the standards for documenting unexplained injuries in children, and used the same way by the one field-hospital system with a published evaluation." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-fluid-balance> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-fluid-balance" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Fluid balance" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Fluid in and out. Required separately for children, and for burns the regime has to be calculated from the time of arrival — so the time matters as much as the number." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-handover> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-handover" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Handover — who has the patient now" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Tracks who is responsible while a referral is in progress. The standards are explicit that responsibility remains with the transferring staff until handover is carried out with the receiving facility, so a referred patient stays on our queue until this reaches completed." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/mass-casualty-mode> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/mass-casualty-mode" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Mass casualty mode" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Whether this visit was triaged under mass-casualty rules rather than ordinary ones." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-medication-given> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-medication-given" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Medicine given" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A drug that actually went into this patient, at a time, by someone. Not a prescription — in a field clinic the person who decides and the person who hands over the tablets are usually the same person in the same tent, and what a later clinician needs to know is what the patient actually received. Answers 'what have we already given them?' at three in the morning, which a note in prose cannot." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-medication-taken> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-medication-taken" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Medicine they already take" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "What this patient was on before they met us, as far as anyone knows. Required to give two weeks of treatment continuity for a chronic condition (Blue Book 5.1.10), and required before giving anything that might interact. Often the patient is the only source and the bottle is gone — so 'they said a white tablet for blood pressure' is a legitimate entry and must be recordable." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-medication-take-home> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-medication-take-home" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Medicine they took away" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "What was counted out and handed over at the end of the visit — the drug, how much of it, and when they were given it. Distinct from what was given in the tent: this is a supply the patient administers themselves, somewhere else, for days. A later clinician asks how much they were given and whether it has run out, and neither question can be answered from an administration record." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-muac> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-muac" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Mid-upper arm circumference" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A tape measure round a child's arm, the standard field test for malnutrition. Taken at first contact and triage, not later in the visit. Recorded as a number in millimetres and never as a yes/no, because the threshold is contested: one long-cited definition says under 110mm, current guidance says 115mm, and screening evidence argues for higher still. Store the measurement and let the deployment set the line." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-notifiable-disease> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-notifiable-disease" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Notifiable disease" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A condition under outbreak surveillance. Needs more than an ordinary diagnosis because the alerting rules depend on it: one suspected case of cholera or measles is an alert, one confirmed case is an outbreak. Without the classification those rules cannot be written, and the failure would be an alert that never fires." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-pain-score> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-pain-score" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Pain" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "How much pain the patient is in. The standards require pain to be assessed on arrival AND repeatedly during the stay, so a single score at triage satisfies nothing — which is why the time is mandatory here." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-patient> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-patient" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Patient" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A person we are treating. Identity in a disaster is unreliable — names are spelled several ways, people cannot always give one, and some arrive unconscious. So the record's own key is a UUID generated on the device at the moment of registration and never changed, and everything a human says out loud is an identifier rather than a key." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-consent> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-consent" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Permission for one specific thing" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Recorded per act, never once per patient. Treating someone and writing it down does not rest on their permission — they are told, and can object. But permission is required separately for sharing or referring, for recording sexual violence, for a procedure or anaesthetic, for transfer, and for a photograph. Someone agreeing to be treated has not thereby agreed to have their assault recorded." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-pregnancy-status> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-pregnancy-status" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Pregnant or not" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Recorded because it changes care — which drugs are safe, which thresholds apply, who needs obstetric review, and whether a second person is at stake. An observation and not a field on the patient, because pregnancy is a state with a beginning and an end rather than an attribute of a person." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-referral> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-referral" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Referral — what we are asking for" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The clinical ask: what this patient needs, why, and from whom. Paired with a handover task that carries the state, because responsibility does not move when the request is written." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/disaster-relation> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/disaster-relation" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Relation to the disaster" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Whether this problem was caused by the disaster. Nothing about the patient's care changes with the answer — it is an obligation the team owes upward, never a clinical question, and it is never asked during a consultation. Defaults to unknown, and unknown is a complete answer. On the Condition rather than the visit, because cause is true of a problem: one visit can hold a crush injury and long-standing diabetes." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CodeSystem" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/CodeSystem/disaster-relation-cs> ;
         fhir:Reference.reference [ fhir:value "CodeSystem/disaster-relation-cs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Relation to the disaster (code system)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Whether a problem was caused by the disaster: directly, indirectly, not related, or not known." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ValueSet" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/ValueSet/disaster-relation-vs> ;
         fhir:Reference.reference [ fhir:value "ValueSet/disaster-relation-vs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Relation to the disaster (value set)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Whether a problem was caused by the disaster. Not known is the default and is a complete answer." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-procedure> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-procedure" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Something done to the patient" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Major means it usually needed general anaesthesia and hospitalisation; minor means local anaesthesia and no hospitalisation. Counted on the day it was performed, which may not be the day the patient was registered." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-problem> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-problem" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Standing problem" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Something already true of this patient before they walked in — diabetes, epilepsy, a previous amputation. Held separately from today's diagnosis because it is not a health event of this visit and must not be counted as one." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ValueSet" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/ValueSet/notifiable-verification-vs> ;
         fhir:Reference.reference [ fhir:value "ValueSet/notifiable-verification-vs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Suspected, probable, confirmed" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Three of FHIR's six verification statuses, matching the surveillance vocabulary." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-patient-summary> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-patient-summary" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "The copy the patient keeps" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Every patient is offered a record of the treatment performed, and a referral for follow-up where needed. Shaped like an International Patient Summary because that standard exists for exactly this — a clinician who has never met this person, reading it cold. In a real deployment three quarters of patients leave with no follow-up arranged, which makes this the most-used artefact in the system." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-organization> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-organization" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "The team" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The emergency medical team itself, and its type — Type 1 mobile or fixed, Type 2 with surgery and beds, Type 3 with intensive care. Type decides what the team can treat and therefore what it must refer." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-deterioration-flag> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-deterioration-flag" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "This patient is getting worse" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Set by a clinician, not computed. The standards require a mechanism to promptly detect deteriorating patients; recording that judgement is in scope, predicting it is not." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/treatment-level> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/treatment-level" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Treatment level required" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Major, moderate or minor. Mostly a statement about where this patient can be looked after: major needs a Type 2 or 3 team with surgery and beds, minor is within what a Type 1 mobile team can do. It is the judgement that decides whether they stay or travel." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CodeSystem" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/CodeSystem/treatment-level-cs> ;
         fhir:Reference.reference [ fhir:value "CodeSystem/treatment-level-cs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Treatment level required (code system)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Major, moderate or minor — the judgement that decides whether a patient can be looked after here or has to travel." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ValueSet" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/ValueSet/treatment-level-vs> ;
         fhir:Reference.reference [ fhir:value "ValueSet/treatment-level-vs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Treatment level required (value set)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Major, moderate or minor treatment level." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-triage-assessment> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-triage-assessment" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Triage assessment" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "One triage decision, at one moment, by one person. A patient waiting to be seen is re-assessed and gets another one of these; nothing is overwritten, because a clinician needs to see that this patient was green two hours ago and is red now. The Blue Book requires continued reassessment for Type 2 and 3 teams (5.1.1). The team brings its own triage system, so the value comes from deployment configuration and we ship no categories." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-immunization> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-immunization" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Vaccine given" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A vaccine this patient received from us, or one they tell us they have had. Records what was given rather than a schedule we manage — running routine immunisation programmes is not an emergency medical team's job, but tetanus cover after a wound, post-exposure prophylaxis and outbreak response all are, and checking vaccination status is a named part of discharging a child." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-encounter> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-encounter" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Visit" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "One contact between a patient and the team, from walking up to walking away. Someone seen twice in a day has two of these: the second visit is its own clinical event, with its own triage, its own findings and its own reason for being there." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-vital-signs> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-vital-signs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Vital signs" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Pulse, blood pressure, respiratory rate, temperature, oxygen saturation, weight, and level of consciousness. Recorded at triage and again during the visit — the whole point of a vital sign is the series, not the reading. AVPU is used for consciousness rather than the Glasgow Coma Scale: it is four steps instead of thirteen and survives brief training better." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-transfer-document> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-transfer-document" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "What travels with the patient" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The standards specify the content: the patient's clinical condition, current treatment, the intention to transfer, and the mode and timeline of transfer. Written consent is required before transfer, and pain must be managed before transport." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-return-advice> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-return-advice" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "What we told them to watch for" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The signs that mean come back immediately, and the record that somebody was actually told them. Chosen for this patient's problem rather than read off a general list. For most patients nothing else is arranged, which makes this the only safety net they leave with." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
