       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir-fli.dev/bumblebee/StructureDefinition/bumblebee-location> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bumblebee-location" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Where the team is working" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The site. Carries the state, city and village hierarchy that FHIR has no element for, and a geographic position — in a disaster a team is often in a field with no address, and a place name alone will not bring anyone back to it." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
