       ] ;
       fhir:name [ fhir:v "Evaluation Status Value Set" ] ;
       fhir:description [ fhir:v "Combined value set for dose evaluation status, including HL7 THO standard codes (valid, notvalid) and the Cicada extension code (extraneous)." ] ;
