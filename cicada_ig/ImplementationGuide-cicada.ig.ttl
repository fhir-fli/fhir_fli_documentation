         fhir:reference [ fhir:v "StructureDefinition/evaluation-detail-ext" ]
       ] ;
       fhir:name [ fhir:v "Evaluation Sub-step Detail" ] ;
       fhir:description [ fhir:v "The CDSi Chapter 6 sub-step outcomes behind a dose's evaluation: which of age, interval, conflict and vaccine choice passed, and for those that failed, which rule failed. doseStatusReason carries ten ImmDS codes; the engine knows more than that." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
