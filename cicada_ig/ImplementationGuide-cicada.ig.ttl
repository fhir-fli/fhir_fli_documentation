         fhir:reference [ fhir:v "ValueSet/forecast-status" ]
       ] ;
       fhir:name [ fhir:v "Forecast Status Value Set" ] ;
       fhir:description [ fhir:v "Combined value set for immunization forecast status, referencing published standard CodeSystems. Includes ImmDS IG ForecastStatus (CDSi-compatible), HL7 THO immunization-recommendation-status, and LOINC answer list LL940-8." ] ;
