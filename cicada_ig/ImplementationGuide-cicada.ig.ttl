       fhir:reference [
         fhir:l <http://fhirfli.dev/fhir/ig/cicada/ValueSet/dose-status-reason> ;
         fhir:reference [ fhir:v "ValueSet/dose-status-reason" ]
       ] ;
       fhir:name [ fhir:v "Dose Status Reason Value Set" ] ;
       fhir:description [ fhir:v "Value set for dose evaluation status reasons, referencing the published ImmDS IG StatusReason CodeSystem." ] ;
       fhir:example [
         a fhir:Boolean ;
