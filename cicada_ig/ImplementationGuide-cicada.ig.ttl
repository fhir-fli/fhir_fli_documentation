         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://fhirfli.dev/fhir/ig/cicada/CodeSystem/cdsi-observation-codes> ;
         fhir:reference [ fhir:v "CodeSystem/cdsi-observation-codes" ]
       ] ;
       fhir:name [ fhir:v "CDSI Observation Codes" ] ;
       fhir:description [ fhir:v "Observations and Conditions that are important to indications or contraindications in vaccine forecasting" ] ;
