       ] ;
       fhir:name [ fhir:v "Doses Remaining" ] ;
       fhir:description [ fhir:v "How many doses remain in the series after the one being forecast, or 'Recurring' where the series ends in a recurring dose. seriesDoses and doseNumber allow a reader to subtract, but no arithmetic says the series never ends." ] ;
