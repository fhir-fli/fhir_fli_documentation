       fhir:reference [
         fhir:l <http://fhirfli.dev/fhir/ig/cicada/StructureDefinition/VaccineConditionFhir> ;
         fhir:reference [ fhir:v "StructureDefinition/VaccineConditionFhir" ]
       ] ;
       fhir:name [ fhir:v "Condition Profile with Vaccine Condition Codes" ] ;
       fhir:description [ fhir:v "Profile for conditions where the code must be from the Vaccine Condition Codes value set. Accepts SNOMED CT and ICD-10-CM coded conditions." ] ;
