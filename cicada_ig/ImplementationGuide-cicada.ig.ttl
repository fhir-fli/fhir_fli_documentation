         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://fhirfli.dev/fhir/ig/cicada/ValueSet/forecast-reason-vs> ;
