           a fhir:String ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://fhirfli.dev/fhir/ig/cicada/ValueSet/data-integrity-vs> ;
         fhir:reference [ fhir:v "ValueSet/data-integrity-vs" ]
       ] ;
       fhir:name [ fhir:v "Cicada Data Integrity Value Set" ] ;
       fhir:description [ fhir:v "Reasons a dose was reported rather than evaluated." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
